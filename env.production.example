# Use the domain only, without https://. Point its DNS A record at this server.
DOMAIN=image.cyanyi.com

POSTGRES_DB=cyanyi
POSTGRES_USER=cyanyi
# Generate a URL-safe password with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

# Generate a unique value with: openssl rand -hex 32
APP_SECRET=replace-with-openssl-rand-hex-32

# Optional application settings can be added below, for example SMTP credentials.
