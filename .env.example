# Optional: AI Gateway credentials for the default demo route.
# The chat UI can also use a Base URL and API Key entered in Settings.
AI_GATEWAY_API_KEY=

# Required in production. Use a unique high-entropy value to encrypt provider
# credentials and sign local media URLs. Public development defaults are rejected.
APP_SECRET=

# Workflow lease and recovery timeouts.
WORKFLOW_RUN_LEASE_MS=30000
WORKFLOW_LEASE_RECOVERY_GRACE_MS=30000
WORKFLOW_CANCEL_TIMEOUT_MS=300000

# PostgreSQL database used by Prisma.
DATABASE_URL=postgresql://cyanyi:cyanyi@localhost:5432/cyanyi

# Redis used by BullMQ, task events and distributed locks.
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO for local development).
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cyanyi
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Used when STORAGE_PROVIDER=local. Files are stored under the project .media directory.
APP_BASE_URL=http://localhost:3000

# Authentication fallbacks used until an administrator saves database settings.
REGISTRATION_ENABLED=true
EMAIL_AUTH_ENABLED=true
EMAIL_VERIFICATION_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Optional OAuth fallbacks. Callback URLs are based on APP_BASE_URL.
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINUXDO_OAUTH_ENABLED=false
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_MINIMUM_TRUST_LEVEL=0

# Optional standard Epay fallback. Prefer configuring this in Administrator Settings.
EPAY_ENABLED=false
EPAY_GATEWAY_URL=
EPAY_MERCHANT_ID=
EPAY_MERCHANT_KEY=
EPAY_MINIMUM_AMOUNT=1
EPAY_CREDIT_RATE=1

# Disabled by default. Enable only for a trusted local/admin environment.
BILLING_ALLOW_MANUAL_CREDIT=false
BILLING_ALLOW_PRICE_ADMIN=false

# Optional override for the FFmpeg binary used for audio merging and normalized timeline rendering.
FFMPEG_PATH=

# Optional: override the OpenAI-compatible image/video provider paths used by /api/chat.
# The same Base URL and API Key entered in Settings are reused for media generation.
OPENAI_COMPATIBLE_IMAGE_GENERATION_PATH=images/generations
OPENAI_COMPATIBLE_IMAGE_EDIT_PATH=images/edits
OPENAI_COMPATIBLE_IMAGE_EDIT_FILE_FIELD=image[]
OPENAI_COMPATIBLE_VIDEO_CREATE_PATH=videos/generations
OPENAI_COMPATIBLE_VIDEO_STATUS_PATH=videos/generations/{id}
OPENAI_COMPATIBLE_VIDEO_STATUS_METHOD=GET
OPENAI_COMPATIBLE_VIDEO_POLL_INTERVAL_MS=3000
OPENAI_COMPATIBLE_VIDEO_POLL_TIMEOUT_MS=180000
