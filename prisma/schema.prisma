generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ChannelScope {
  USER
  SYSTEM
}

model User {
  id                             String                   @id @default(uuid())
  email                          String?                  @unique
  passwordHash                   String?                  @map("password_hash")
  emailVerifiedAt                DateTime?                @map("email_verified_at")
  displayName                    String                   @map("display_name")
  anonymous                      Boolean                  @default(false)
  role                           UserRole                 @default(USER)
  createdAt                      DateTime                 @default(now()) @map("created_at")
  updatedAt                      DateTime                 @updatedAt @map("updated_at")
  sessions                       Session[]
  channels                       Channel[]
  projects                       Project[]
  mediaTasks                     MediaTask[]
  workflowRuns                   WorkflowRun[]
  voicePresets                   VoicePreset[]
  globalCharacters               GlobalCharacter[]
  globalLocations                GlobalLocation[]
  globalVoices                   GlobalVoice[]
  globalFolders                  GlobalAssetFolder[]
  userBalance                    UserBalance?
  balanceFreezes                 BalanceFreeze[]
  balanceTransactions            BalanceTransaction[]
  usageCosts                     UsageCost[]
  productionDeliverables         ProductionDeliverable[]  @relation("ProductionDeliverableOwner")
  approvedProductionDeliverables ProductionDeliverable[]  @relation("ProductionDeliverableApprover")
  productionApprovalDecisions    ProductionApprovalGate[] @relation("ProductionApprovalDecider")
  runtimeSettings                UserRuntimeSettings?
  externalIdentities             ExternalIdentity[]
  paymentOrders                  PaymentOrder[]

  @@map("users")
}

model UserRuntimeSettings {
  id                              String   @id
  userId                          String   @unique @map("user_id")
  structuredRequestTimeoutSeconds Int      @default(600) @map("structured_request_timeout_seconds")
  structuredOutputStreaming       Boolean  @default(true) @map("structured_output_streaming")
  structuredTransportMaxAttempts  Int      @default(3) @map("structured_transport_max_attempts")
  workflowStepMaxAttempts         Int      @default(3) @map("workflow_step_max_attempts")
  workflowConcurrency             Int      @default(2) @map("workflow_concurrency")
  screenplayClipMaxChars          Int      @default(1600) @map("screenplay_clip_max_chars")
  imageGenerationRatio            String   @default("1:1") @map("image_generation_ratio")
  imageGenerationResolution       String   @default("1k") @map("image_generation_resolution")
  imageGenerationCount            Int      @default(1) @map("image_generation_count")
  imageGenerationQuality          String   @default("high") @map("image_generation_quality")
  videoGenerationRatio            String   @default("16:9") @map("video_generation_ratio")
  videoGenerationResolution       String   @default("1080p") @map("video_generation_resolution")
  videoGenerationDuration         String   @default("10s") @map("video_generation_duration")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")
  user                            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_runtime_settings")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerification {
  id           String    @id @default(uuid())
  email        String
  purpose      String
  codeHash     String    @map("code_hash")
  attemptCount Int       @default(0) @map("attempt_count")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model ExternalIdentity {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(191)
  username       String?
  profileJson    Json?    @map("profile_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("external_identities")
}

model AuthFlow {
  id              String    @id @default(uuid())
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  provider        String    @db.VarChar(32)
  intent          String    @default("login") @db.VarChar(32)
  redirectPath    String    @default("/chat") @map("redirect_path") @db.VarChar(512)
  anonymousUserId String?   @map("anonymous_user_id")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([provider, expiresAt])
  @@index([expiresAt, consumedAt])
  @@map("auth_flows")
}

model SystemSettings {
  id                           String   @id @default("global") @db.VarChar(32)
  registrationEnabled          Boolean  @default(true) @map("registration_enabled")
  emailAuthEnabled             Boolean  @default(true) @map("email_auth_enabled")
  emailVerificationEnabled     Boolean  @default(false) @map("email_verification_enabled")
  smtpHost                     String?  @map("smtp_host")
  smtpPort                     Int      @default(465) @map("smtp_port")
  smtpSecure                   Boolean  @default(true) @map("smtp_secure")
  smtpUsername                 String?  @map("smtp_username")
  smtpPasswordEncrypted        String?  @map("smtp_password_encrypted") @db.Text
  smtpFrom                     String?  @map("smtp_from")
  githubEnabled                Boolean  @default(false) @map("github_enabled")
  githubClientId               String?  @map("github_client_id")
  githubClientSecretEncrypted  String?  @map("github_client_secret_encrypted") @db.Text
  linuxdoEnabled               Boolean  @default(false) @map("linuxdo_enabled")
  linuxdoClientId              String?  @map("linuxdo_client_id")
  linuxdoClientSecretEncrypted String?  @map("linuxdo_client_secret_encrypted") @db.Text
  linuxdoMinimumTrustLevel     Int      @default(0) @map("linuxdo_minimum_trust_level")
  epayEnabled                  Boolean  @default(false) @map("epay_enabled")
  epayGatewayUrl               String?  @map("epay_gateway_url")
  epayMerchantId               String?  @map("epay_merchant_id")
  epayMerchantKeyEncrypted     String?  @map("epay_merchant_key_encrypted") @db.Text
  epayMethods                  Json?    @map("epay_methods")
  epayMinimumAmount            Decimal  @default(1) @map("epay_minimum_amount") @db.Decimal(18, 6)
  epayCreditRate               Decimal  @default(1) @map("epay_credit_rate") @db.Decimal(18, 6)
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Channel {
  id               String          @id
  userId           String          @map("user_id")
  name             String
  providerKey      String          @default("custom") @map("provider_key")
  protocol         String
  baseUrl          String          @map("base_url")
  encryptedApiKeys String          @map("encrypted_api_keys") @db.Text
  scope            ChannelScope    @default(SYSTEM)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  models           ProviderModel[]

  @@index([userId, createdAt])
  @@index([scope, enabled])
  @@map("channels")
}

model ProviderModel {
  id               String   @id
  channelId        String   @map("channel_id")
  modelId          String   @map("model_id")
  name             String
  modelType        String   @map("model_type")
  capabilitiesJson String   @map("capabilities_json") @db.Text
  selected         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, modelId])
  @@index([channelId])
  @@map("models")
}

model Project {
  id                     String                  @id
  userId                 String                  @map("user_id")
  name                   String
  description            String?                 @db.Text
  lastAccessedAt         DateTime?               @map("last_accessed_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  config                 ProjectConfig?
  manuscripts            Manuscript[]
  episodes               Episode[]
  mediaTasks             MediaTask[]
  characters             NovelCharacter[]
  locations              NovelLocation[]
  props                  NovelProp[]
  voicePresets           VoicePreset[]
  storyboards            Storyboard[]
  clips                  StoryClip[]
  shots                  StoryShot[]
  assetReferences        AssetReference[]
  workflowRuns           WorkflowRun[]
  usageCosts             UsageCost[]
  productionDeliverables ProductionDeliverable[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model ProjectConfig {
  id                      String   @id
  projectId               String   @unique @map("project_id")
  analysisModel           String?  @map("analysis_model")
  characterModel          String?  @map("character_model")
  locationModel           String?  @map("location_model")
  storyboardModel         String?  @map("storyboard_model")
  editModel               String?  @map("edit_model")
  videoModel              String?  @map("video_model")
  audioModel              String?  @map("audio_model")
  videoRatio              String   @default("9:16") @map("video_ratio")
  videoResolution         String   @default("720p") @map("video_resolution")
  artStyle                String   @default("american-comic") @map("art_style")
  visualEra               String   @default("source") @map("visual_era") @db.VarChar(32)
  visualEraCustom         String?  @map("visual_era_custom") @db.Text
  ttsRate                 String   @default("+50%") @map("tts_rate")
  workflowMode            String   @default("novel-promotion") @map("workflow_mode")
  globalAssetText         String?  @map("global_asset_text") @db.Text
  capabilityOverridesJson String?  @map("capability_overrides_json") @db.Text
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_configs")
}

model Episode {
  id                     String                  @id
  projectId              String                  @map("project_id")
  episodeNumber          Int                     @map("episode_number")
  name                   String
  description            String?                 @db.Text
  novelText              String?                 @map("novel_text") @db.Text
  activeSourceId         String?                 @map("active_source_id")
  activeSourceKind       String                  @default("original") @map("active_source_kind") @db.VarChar(32)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaTasks             MediaTask[]
  storyboard             Storyboard?
  clips                  StoryClip[]
  shots                  StoryShot[]
  voiceLines             VoiceLine[]
  audioTracks            EpisodeAudioTrack[]
  editorProject          EditorProject?
  assetReferences        AssetReference[]
  workflowRuns           WorkflowRun[]
  productionDeliverables ProductionDeliverable[]
  sourceVersions         EpisodeSourceVersion[]

  @@unique([projectId, episodeNumber])
  @@index([projectId, episodeNumber])
  @@map("episodes")
}

model Manuscript {
  id             String                 @id
  projectId      String                 @map("project_id")
  title          String
  author         String?
  synopsis       String?                @db.Text
  sourceFileName String?                @map("source_file_name")
  sourceText     String                 @map("source_text") @db.Text
  sourceHash     String                 @map("source_hash") @db.VarChar(64)
  charCount      Int                    @map("char_count")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVersions EpisodeSourceVersion[]

  @@unique([projectId, sourceHash])
  @@index([projectId, createdAt])
  @@map("manuscripts")
}

model EpisodeSourceVersion {
  id               String      @id
  episodeId        String      @map("episode_id")
  manuscriptId     String?     @map("manuscript_id")
  kind             String      @db.VarChar(32)
  version          Int
  title            String?
  summary          String?     @db.Text
  content          String      @db.Text
  adaptationMode   String?     @map("adaptation_mode") @db.VarChar(32)
  instructions     String?     @db.Text
  changeSummary    Json?       @map("change_summary")
  promptTrace      Json?       @map("prompt_trace")
  channelId        String?     @map("channel_id")
  model            String?
  sourceHash       String      @map("source_hash") @db.VarChar(64)
  sourceStartIndex Int?        @map("source_start_index")
  sourceEndIndex   Int?        @map("source_end_index")
  createdAt        DateTime    @default(now()) @map("created_at")
  episode          Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  manuscript       Manuscript? @relation(fields: [manuscriptId], references: [id], onDelete: SetNull)

  @@unique([episodeId, kind, version])
  @@index([episodeId, createdAt])
  @@index([manuscriptId])
  @@map("episode_source_versions")
}

model MediaTask {
  id                String           @id
  userId            String           @map("user_id")
  traceId           String           @map("trace_id") @db.VarChar(64)
  spanId            String           @unique @map("span_id") @db.VarChar(64)
  parentSpanId      String?          @map("parent_span_id") @db.VarChar(64)
  workflowRunId     String?          @map("workflow_run_id")
  workflowStepId    String?          @map("workflow_step_id")
  channelId         String?          @map("channel_id")
  idempotencyKey    String?          @map("idempotency_key")
  projectId         String?          @map("project_id")
  episodeId         String?          @map("episode_id")
  batchId           String?          @map("batch_id")
  targetType        String?          @map("target_type")
  targetId          String?          @map("target_id")
  status            String
  kind              String
  provider          String
  protocol          String
  model             String
  providerTaskId    String?          @map("provider_task_id")
  payload           Json
  error             Json?
  retryCount        Int              @default(0) @map("retry_count")
  maxRetries        Int              @default(2) @map("max_retries")
  progress          Int              @default(0)
  progressMessage   String?          @map("progress_message") @db.Text
  queueJobId        String?          @map("queue_job_id")
  cancelRequestedAt DateTime?        @map("cancel_requested_at")
  heartbeatAt       DateTime?        @map("heartbeat_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  startedAt         DateTime?        @map("started_at")
  completedAt       DateTime?        @map("completed_at")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode           Episode?         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  workflowRun       WorkflowRun?     @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStep      WorkflowStep?    @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  assets            MediaAsset[]
  events            MediaTaskEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
  @@index([episodeId, updatedAt])
  @@index([batchId, updatedAt])
  @@index([channelId, updatedAt])
  @@index([traceId, createdAt])
  @@index([workflowRunId, workflowStepId])
  @@map("media_tasks")
}

model MediaTaskEvent {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  type      String
  status    String?
  progress  Int?
  message   String?   @db.Text
  payload   Json?
  createdAt DateTime  @default(now()) @map("created_at")
  task      MediaTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("media_task_events")
}

model MediaAsset {
  id                         String                      @id
  taskId                     String                      @map("task_id")
  kind                       String
  storageKey                 String?                     @map("storage_key")
  url                        String?                     @db.Text
  mimeType                   String?                     @map("mime_type")
  metadataJson               String?                     @map("metadata_json") @db.Text
  createdAt                  DateTime                    @default(now()) @map("created_at")
  task                       MediaTask                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  references                 AssetReference[]
  characterAppearanceImages  CharacterAppearance[]       @relation("CharacterAppearanceImage")
  locationImages             LocationImage[]             @relation("LocationImageAsset")
  storyboardPanelImages      StoryboardPanel[]           @relation("StoryboardPanelImage")
  storyboardPanelVideos      StoryboardPanel[]           @relation("StoryboardPanelVideo")
  storyboardPanelLipSync     StoryboardPanel[]           @relation("StoryboardPanelLipSync")
  globalCharAppearanceImages GlobalCharacterAppearance[] @relation("GlobalCharAppearanceImage")
  globalLocImages            GlobalLocationImage[]       @relation("GlobalLocImageAsset")
  storyShotImages            StoryShot[]                 @relation("StoryShotImage")
  storyShotVideos            StoryShot[]                 @relation("StoryShotVideo")
  voicePresetSamples         VoicePreset[]               @relation("VoicePresetSample")
  voiceLineAudio             VoiceLine[]                 @relation("VoiceLineAudio")
  episodeAudioTracks         EpisodeAudioTrack[]         @relation("EpisodeAudioTrackAsset")
  editorOutputs              EditorProject[]             @relation("EditorOutputAsset")

  @@index([taskId])
  @@map("media_assets")
}

model NovelCharacter {
  id                String                @id
  projectId         String                @map("project_id")
  name              String
  aliases           String?               @db.Text
  profileJson       String?               @map("profile_json") @db.Text
  visualProfileJson String?               @map("visual_profile_json") @db.Text
  introduction      String?               @db.Text
  confirmed         Boolean               @default(false)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  appearances       CharacterAppearance[]

  @@unique([projectId, name])
  @@index([projectId, updatedAt])
  @@map("novel_characters")
}

model CharacterAppearance {
  id              String         @id
  characterId     String         @map("character_id")
  appearanceIndex Int            @map("appearance_index")
  description     String?        @db.Text
  imageAssetId    String?        @map("image_asset_id")
  selected        Boolean        @default(false)
  metadataJson    String?        @map("metadata_json") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  character       NovelCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  imageAsset      MediaAsset?    @relation("CharacterAppearanceImage", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@unique([characterId, appearanceIndex])
  @@index([characterId, updatedAt])
  @@index([imageAssetId])
  @@map("character_appearances")
}

model NovelLocation {
  id                String          @id
  projectId         String          @map("project_id")
  name              String
  summary           String?         @db.Text
  visualProfileJson String?         @map("visual_profile_json") @db.Text
  selectedImageId   String?         @map("selected_image_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images            LocationImage[] @relation("LocationImages")
  selectedImage     LocationImage?  @relation("SelectedLocationImage", fields: [selectedImageId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@index([projectId, updatedAt])
  @@index([selectedImageId])
  @@map("novel_locations")
}

model NovelProp {
  id                String   @id
  projectId         String   @map("project_id")
  name              String
  summary           String?  @db.Text
  metadataJson      String?  @map("metadata_json") @db.Text
  visualProfileJson String?  @map("visual_profile_json") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, updatedAt])
  @@map("novel_props")
}

model LocationImage {
  id             String          @id
  locationId     String          @map("location_id")
  imageIndex     Int             @map("image_index")
  description    String?         @db.Text
  availableSlots String?         @map("available_slots") @db.Text
  metadataJson   String?         @map("metadata_json") @db.Text
  imageAssetId   String?         @map("image_asset_id")
  selected       Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  location       NovelLocation   @relation("LocationImages", fields: [locationId], references: [id], onDelete: Cascade)
  selectedBy     NovelLocation[] @relation("SelectedLocationImage")
  imageAsset     MediaAsset?     @relation("LocationImageAsset", fields: [imageAssetId], references: [id], onDelete: SetNull)

  @@unique([locationId, imageIndex])
  @@index([locationId, updatedAt])
  @@index([imageAssetId])
  @@map("location_images")
}

model Storyboard {
  id         String            @id
  projectId  String            @map("project_id")
  episodeId  String            @unique @map("episode_id")
  status     String            @default("draft")
  version    Int               @default(1)
  sourceHash String?           @map("source_hash")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episode    Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  panels     StoryboardPanel[]

  @@index([projectId, updatedAt])
  @@map("storyboards")
}

model StoryboardPanel {
  id                             String      @id
  storyboardId                   String      @map("storyboard_id")
  clipId                         String?     @map("clip_id")
  clipPanelIndex                 Int?        @map("clip_panel_index")
  panelIndex                     Int         @map("panel_index")
  sceneNumber                    Int?        @map("scene_number")
  shotType                       String?     @map("shot_type")
  cameraMove                     String?     @map("camera_move") @db.Text
  description                    String?     @db.Text
  locationName                   String?     @map("location_name")
  charactersJson                 String?     @map("characters_json") @db.Text
  propsJson                      String?     @map("props_json") @db.Text
  imagePrompt                    String?     @map("image_prompt") @db.Text
  videoPrompt                    String?     @map("video_prompt") @db.Text
  imagePromptDesignJson          String?     @map("image_prompt_design_json") @db.Text
  videoPromptDesignJson          String?     @map("video_prompt_design_json") @db.Text
  firstLastFramePromptDesignJson String?     @map("first_last_frame_prompt_design_json") @db.Text
  phase                          String      @default("phase1")
  status                         String      @default("draft")
  srtStart                       Float?      @map("srt_start")
  srtEnd                         Float?      @map("srt_end")
  durationSeconds                Float?      @map("duration_seconds")
  subtitleText                   String?     @map("subtitle_text") @db.Text
  speakingCharacter              String?     @map("speaking_character")
  lipSyncText                    String?     @map("lip_sync_text") @db.Text
  voiceoverText                  String?     @map("voiceover_text") @db.Text
  startStateJson                 String?     @map("start_state_json") @db.Text
  endStateJson                   String?     @map("end_state_json") @db.Text
  motionBeatsJson                String?     @map("motion_beats_json") @db.Text
  worldContextJson               String?     @map("world_context_json") @db.Text
  vfxCuesJson                    String?     @map("vfx_cues_json") @db.Text
  sfxCuesJson                    String?     @map("sfx_cues_json") @db.Text
  actingNotesJson                String?     @map("acting_notes_json") @db.Text
  photographyRules               String?     @map("photography_rules") @db.Text
  firstLastFramePrompt           String?     @map("first_last_frame_prompt") @db.Text
  linkedToNextPanel              Boolean     @default(false) @map("linked_to_next_panel")
  sourceEvidenceJson             String?     @map("source_evidence_json") @db.Text
  imageAssetId                   String?     @map("image_asset_id")
  videoAssetId                   String?     @map("video_asset_id")
  lipSyncAssetId                 String?     @map("lip_sync_asset_id")
  createdAt                      DateTime    @default(now()) @map("created_at")
  updatedAt                      DateTime    @updatedAt @map("updated_at")
  storyboard                     Storyboard  @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  clip                           StoryClip?  @relation(fields: [clipId], references: [id], onDelete: SetNull)
