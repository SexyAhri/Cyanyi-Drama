  episode           Episode?              @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  steps             WorkflowStep[]
  events            WorkflowEvent[]
  artifacts         WorkflowArtifact[]
  checkpoints       WorkflowCheckpoint[]
  stepAttempts      WorkflowStepAttempt[]
  mediaTasks        MediaTask[]

  @@index([userId, createdAt])
  @@index([projectId, status])
  @@index([episodeId, createdAt])
  @@index([workflowType, targetType, targetId, status])
  @@index([leaseExpiresAt])
  @@map("workflow_runs")
}

model WorkflowStep {
  id            String                @id
  runId         String                @map("run_id")
  traceId       String                @map("trace_id") @db.VarChar(64)
  spanId        String                @unique @map("span_id") @db.VarChar(64)
  parentSpanId  String                @map("parent_span_id") @db.VarChar(64)
  stepKey       String                @map("step_key")
  stepType      String                @map("step_type")
  stepIndex     Int                   @map("step_index")
  status        String                @default("pending")
  dependsOn     Json?
  artifactTypes Json?
  retryable     Boolean               @default(true)
  failureMode   String                @default("fail_run") @map("failure_mode")
  attempt       Int                   @default(0)
  maxAttempts   Int                   @default(3) @map("max_attempts")
  input         Json?
  output        Json?
  error         Json?
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
