  createdAt      DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiType])
  @@index([createdAt])
  @@index([projectId])
  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("usage_costs")
}

// === Workflow Checkpoint & Step Attempts ===

model WorkflowCheckpoint {
  id         String   @id @default(uuid())
  runId      String   @map("run_id")
  stepKey    String   @map("step_key")
  version    Int
  stateJson  Json     @map("state_json")
  stateBytes Int      @default(0) @map("state_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepKey, version])
  @@index([runId, createdAt])
  @@map("workflow_checkpoints")
}

model WorkflowStepAttempt {
  id           String    @id @default(uuid())
  runId        String    @map("run_id")
  stepId       String    @map("step_id")
  attempt      Int
  status       String    @default("pending")
  provider     String?
  modelKey     String?   @map("model_key")
  inputHash    String?   @map("input_hash")
  input        Json?
  outputText   String?   @map("output_text") @db.Text
  usageJson    Json?     @map("usage_json")
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  run  WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([runId, stepId])
  @@index([stepId, attempt])
  @@map("workflow_step_attempts")
}

// === Media Hash Dedup ===

model MediaHash {
  id         String   @id @default(uuid())
  sha256     String   @unique
  storageKey String   @map("storage_key") @db.VarChar(512)
  mimeType   String?  @map("mime_type")
  sizeBytes  BigInt?  @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sha256])
  @@map("media_hashes")
}

model ModelPrice {
  id         String   @id @default(uuid())
  provider   String
  model      String
  capability String
  unit       String
  unitPrice  Decimal  @map("unit_price") @db.Decimal(18, 6)
  active     Boolean  @default(true)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([provider, model, capability, unit])
  @@index([provider, model, active])
  @@map("model_prices")
}

model PaymentOrder {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  tradeNo         String    @unique @map("trade_no") @db.VarChar(64)
  provider        String    @default("epay") @db.VarChar(32)
  paymentMethod   String    @map("payment_method") @db.VarChar(32)
  amount          Decimal   @db.Decimal(18, 6)
  creditAmount    Decimal   @map("credit_amount") @db.Decimal(18, 6)
  status          String    @default("pending") @db.VarChar(32)
  providerTradeNo String?   @map("provider_trade_no") @db.VarChar(191)
  notifyPayload   Json?     @map("notify_payload")
  expiresAt       DateTime? @map("expires_at")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_orders")
}
